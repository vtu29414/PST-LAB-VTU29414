Program:
import java.util.*;

public class Solution {

    static class DSU {
        int[] parent;
        int[] rank;
        boolean[] hasMachine;

        DSU(int n, boolean[] machines) {
            parent = new int[n];
            rank = new int[n];
            hasMachine = new boolean[n];

            for (int i = 0; i < n; i++) {
                parent[i] = i;
                hasMachine[i] = machines[i];
            }
        }

        int find(int x) {
            if (parent[x] != x) {
                parent[x] = find(parent[x]);
            }
            return parent[x];
        }

        void union(int a, int b) {
            int pa = find(a);
            int pb = find(b);

            if (pa == pb) return;

            if (rank[pa] < rank[pb]) {
                parent[pa] = pb;
                hasMachine[pb] |= hasMachine[pa];
            } else if (rank[pb] < rank[pa]) {
                parent[pb] = pa;
                hasMachine[pa] |= hasMachine[pb];
            } else {
                parent[pb] = pa;
                hasMachine[pa] |= hasMachine[pb];
                rank[pa]++;
            }
        }
    }

    static class Road {
        int u, v, cost;

        Road(int u, int v, int cost) {
            this.u = u;
            this.v = v;
            this.cost = cost;
        }
    }

    public static int minTime(int[][] roads, int[] machines) {

        int n = roads.length + 1;

        boolean[] machineCity = new boolean[n];
        for (int m : machines) {
            machineCity[m] = true;
        }

        List<Road> list = new ArrayList<>();

        for (int[] road : roads) {
            list.add(new Road(road[0], road[1], road[2]));
        }

        // Sort by descending destruction time
        list.sort((a, b) -> b.cost - a.cost);

        DSU dsu = new DSU(n, machineCity);

        long answer = 0;

        for (Road road : list) {

            int pu = dsu.find(road.u);
            int pv = dsu.find(road.v);

            if (pu == pv) continue;

            if (dsu.hasMachine[pu] && dsu.hasMachine[pv]) {
                // Cut this road
                answer += road.cost;
            } else {
                // Keep this road
                dsu.union(pu, pv);
            }
        }

        return (int) answer;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();

        int[][] roads = new int[n - 1][3];

        for (int i = 0; i < n - 1; i++) {
            roads[i][0] = sc.nextInt();
            roads[i][1] = sc.nextInt();
            roads[i][2] = sc.nextInt();
        }

        int[] machines = new int[k];

        for (int i = 0; i < k; i++) {
            machines[i] = sc.nextInt();
        }

        System.out.println(minTime(roads, machines));

        sc.close();
    }
}
